{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/column-formatting.schema.json",
  "elmType": "div",
  "style": {
    "padding": "2px 10px",
    "border-radius": "12px",
    "font-weight": "700",
    "display": "inline-block",
    "background-color": "=if(@currentField == 'Green', '#16783C', '#BC2229')",
    "color": "#FFFFFF"
  },
  "txtContent": "=if(@currentField == 'Green', 'ADMIT', 'TURN AWAY')"
}
