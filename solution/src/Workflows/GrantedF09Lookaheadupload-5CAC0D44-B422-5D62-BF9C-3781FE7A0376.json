{
  "properties": {
    "connectionReferences": {
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "gr_GrantedOutlook"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "gr_GrantedSharePoint"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "Granted site URL (gr_SiteUrl)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "gr_SiteUrl",
            "description": "The Granted SharePoint site, e.g. https://contoso.sharepoint.com/sites/Granted"
          }
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "PowerAppV2",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "projectId",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "projectId",
                  "x-ms-content-hint": "TEXT"
                },
                "text_1": {
                  "title": "viewAs",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "viewAs",
                  "x-ms-content-hint": "TEXT"
                },
                "text_2": {
                  "title": "payload",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "payload",
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": []
            }
          }
        }
      },
      "actions": {
        "Try": {
          "type": "Scope",
          "actions": {
            "In": {
              "type": "Compose",
              "inputs": "@json(if(empty(triggerBody()?['text_2']), '{}', triggerBody()?['text_2']))",
              "runAfter": {}
            },
            "Caller": {
              "type": "Compose",
              "inputs": "@toLower(triggerOutputs()?['headers']?['x-ms-user-email'])",
              "runAfter": {
                "In": [
                  "Succeeded"
                ]
              }
            },
            "ProjectIdIn": {
              "type": "Compose",
              "inputs": "@trim(coalesce(triggerBody()?['text'], ''))",
              "runAfter": {
                "Caller": [
                  "Succeeded"
                ]
              }
            },
            "Authorize": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "282f0f38-3f85-5ebc-be6e-2c2e1eb17c01"
                },
                "body": {
                  "text": "@{outputs('Caller')}",
                  "text_1": "@{outputs('ProjectIdIn')}",
                  "text_2": "@{coalesce(triggerBody()?['text_1'], '')}",
                  "text_3": "project.settings"
                }
              },
              "runAfter": {
                "ProjectIdIn": [
                  "Succeeded"
                ]
              }
            },
            "Auth": {
              "type": "Compose",
              "inputs": "@json(body('Authorize')?['json'])",
              "runAfter": {
                "Authorize": [
                  "Succeeded"
                ]
              }
            },
            "Is_allowed": {
              "type": "If",
              "expression": "@equals(outputs('Auth')?['ok'], true)",
              "actions": {},
              "else": {
                "actions": {
                  "Not_allowed": {
                    "type": "Response",
                    "kind": "PowerApp",
                    "inputs": {
                      "statusCode": 200,
                      "body": {
                        "json": "@{outputs('Auth')}"
                      },
                      "schema": {
                        "type": "object",
                        "properties": {
                          "json": {
                            "title": "json",
                            "x-ms-dynamically-added": true,
                            "type": "string"
                          }
                        }
                      }
                    },
                    "runAfter": {}
                  },
                  "Not_allowed_end": {
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Succeeded"
                    },
                    "runAfter": {
                      "Not_allowed": [
                        "Succeeded"
                      ]
                    }
                  }
                }
              },
              "runAfter": {
                "Auth": [
                  "Succeeded"
                ]
              }
            },
            "Batch": {
              "type": "Compose",
              "inputs": "@concat(convertFromUtc(utcNow(), outputs('Auth')?['project']?['timeZone'], 'yyyyMMdd-HHmm'), '-', outputs('Caller'))",
              "runAfter": {
                "Is_allowed": [
                  "Succeeded"
                ]
              }
            },
            "Rows": {
              "type": "Query",
              "inputs": {
                "from": "@coalesce(outputs('In')?['rows'], createArray())",
                "where": "@and(not(empty(trim(string(coalesce(item()?['id'], ''))))), not(empty(trim(string(coalesce(item()?['name'], ''))))), equals(length(string(coalesce(item()?['start'], ''))), 10), equals(length(string(coalesce(item()?['finish'], ''))), 10))"
              },
              "runAfter": {
                "Batch": [
                  "Succeeded"
                ]
              }
            },
            "Has_rows": {
              "type": "If",
              "expression": "@greater(length(body('Rows')), 0)",
              "actions": {},
              "else": {
                "actions": {
                  "No_rows": {
                    "type": "Response",
                    "kind": "PowerApp",
                    "inputs": {
                      "statusCode": 200,
                      "body": {
                        "json": "@{string(addProperty(addProperty(json('{}'), 'ok', false), 'message', 'No valid rows found. The CSV needs the columns ID, Activity, Trade, Start, Finish.'))}"
                      },
                      "schema": {
                        "type": "object",
                        "properties": {
                          "json": {
                            "title": "json",
                            "x-ms-dynamically-added": true,
                            "type": "string"
                          }
                        }
                      }
                    },
                    "runAfter": {}
                  },
                  "No_rows_end": {
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Succeeded"
                    },
                    "runAfter": {
                      "No_rows": [
                        "Succeeded"
                      ]
                    }
                  }
                }
              },
              "runAfter": {
                "Rows": [
                  "Succeeded"
                ]
              }
            },
            "All_activities": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('Granted site URL (gr_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/lists/getbytitle('Activities')/items?$filter=ProjectId eq '@{encodeUriComponent(replace(string(outputs('Auth')?['project']?['id']), '''', ''''''))}'&$select=ID,ActivityId,IsCurrent,ImportBatch&$top=5000",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Has_rows": [
                  "Succeeded"
                ]
              }
            },
            "Each_row": {
              "type": "Foreach",
              "foreach": "@body('Rows')",
              "actions": {
                "Existing": {
                  "type": "Query",
                  "inputs": {
                    "from": "@body('All_activities')?['value']",
                    "where": "@equals(item()?['ActivityId'], trim(string(items('Each_row')?['id'])))"
                  },
                  "runAfter": {}
                },
                "Activity_fields": {
                  "type": "Compose",
                  "inputs": {
                    "Title": "@{substring(trim(string(items('Each_row')?['name'])), 0, min(120, length(trim(string(items('Each_row')?['name'])))))}",
                    "Key": "@{concat(outputs('Auth')?['project']?['id'], '|', trim(string(items('Each_row')?['id'])))}",
                    "ProjectId": "@{outputs('Auth')?['project']?['id']}",
                    "ActivityId": "@{trim(string(items('Each_row')?['id']))}",
                    "Trade": "@{trim(string(coalesce(items('Each_row')?['trade'], '')))}",
                    "StartDate": "@{items('Each_row')?['start']}",
                    "FinishDate": "@{items('Each_row')?['finish']}",
                    "IsCurrent": true,
                    "ImportBatch": "@{outputs('Batch')}"
                  },
                  "runAfter": {
                    "Existing": [
                      "Succeeded"
                    ]
                  }
                },
                "Known_activity": {
                  "type": "If",
                  "expression": "@not(empty(body('Existing')))",
                  "actions": {
                    "Update_activity": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_sharepointonline",
                          "operationId": "HttpRequest",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                        },
                        "parameters": {
                          "dataset": "@parameters('Granted site URL (gr_SiteUrl)')",
                          "parameters/method": "POST",
                          "parameters/uri": "_api/web/lists/getbytitle('Activities')/items(@{first(body('Existing'))?['ID']})",
                          "parameters/headers": {
                            "Accept": "application/json;odata=nometadata",
                            "Content-Type": "application/json;odata=nometadata",
                            "IF-MATCH": "*",
                            "X-HTTP-Method": "MERGE"
                          },
                          "parameters/body": "@{outputs('Activity_fields')}"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runAfter": {}
                    }
                  },
                  "else": {
                    "actions": {
                      "Create_activity": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_sharepointonline",
                            "operationId": "HttpRequest",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                          },
                          "parameters": {
                            "dataset": "@parameters('Granted site URL (gr_SiteUrl)')",
                            "parameters/method": "POST",
                            "parameters/uri": "_api/web/lists/getbytitle('Activities')/items",
                            "parameters/headers": {
                              "Accept": "application/json;odata=nometadata",
                              "Content-Type": "application/json;odata=nometadata"
                            },
                            "parameters/body": "@{outputs('Activity_fields')}"
                          },
                          "authentication": "@parameters('$authentication')"
                        },
                        "runAfter": {}
                      }
                    }
                  },
                  "runAfter": {
                    "Activity_fields": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 10
                }
              },
              "runAfter": {
                "All_activities": [
                  "Succeeded"
                ]
              }
            },
            "Uploaded_ids": {
              "type": "Select",
              "inputs": {
                "from": "@body('Rows')",
                "select": "@trim(string(item()?['id']))"
              },
              "runAfter": {
                "Each_row": [
                  "Succeeded"
                ]
              }
            },
            "Dropped": {
              "type": "Query",
              "inputs": {
                "from": "@body('All_activities')?['value']",
                "where": "@and(equals(item()?['IsCurrent'], true), not(contains(body('Uploaded_ids'), item()?['ActivityId'])))"
              },
              "runAfter": {
                "Uploaded_ids": [
                  "Succeeded"
                ]
              }
            },
            "Each_dropped": {
              "type": "Foreach",
              "foreach": "@body('Dropped')",
              "actions": {
                "Not_current_fields": {
                  "type": "Compose",
                  "inputs": {
                    "IsCurrent": false
                  },
                  "runAfter": {}
                },
                "Not_current": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('Granted site URL (gr_SiteUrl)')",
                      "parameters/method": "POST",
                      "parameters/uri": "_api/web/lists/getbytitle('Activities')/items(@{items('Each_dropped')?['ID']})",
                      "parameters/headers": {
                        "Accept": "application/json;odata=nometadata",
                        "Content-Type": "application/json;odata=nometadata",
                        "IF-MATCH": "*",
                        "X-HTTP-Method": "MERGE"
                      },
                      "parameters/body": "@{outputs('Not_current_fields')}"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {
                    "Not_current_fields": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 10
                }
              },
              "runAfter": {
                "Dropped": [
                  "Succeeded"
                ]
              }
            },
            "Audit_lookahead_fields": {
              "type": "Compose",
              "inputs": {
                "Title": "project.settings",
                "ActorEmail": "@{outputs('Caller')}",
                "ProjectId": "@{outputs('Auth')?['project']?['id']}",
                "Target": "@{outputs('Batch')}",
                "Details": "@{concat('Look-ahead: ', string(length(body('Rows'))), ' activities')}",
                "At": "@utcNow()",
                "Maintenance": "@equals(outputs('Auth')?['maintenance'], true)"
              },
              "runAfter": {
                "Each_dropped": [
                  "Succeeded"
                ]
              }
            },
            "Audit_lookahead": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('Granted site URL (gr_SiteUrl)')",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists/getbytitle('AuditLog')/items",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata",
                    "Content-Type": "application/json;odata=nometadata"
                  },
                  "parameters/body": "@{outputs('Audit_lookahead_fields')}"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Audit_lookahead_fields": [
                  "Succeeded"
                ]
              }
            },
            "Loaded_out": {
              "type": "Compose",
              "inputs": {
                "ok": true,
                "loaded": "@length(body('Rows'))",
                "message": "@{concat('Look-ahead updated: ', length(body('Rows')), ' activities.')}"
              },
              "runAfter": {
                "Audit_lookahead": [
                  "Succeeded"
                ]
              }
            },
            "Loaded": {
              "type": "Response",
              "kind": "PowerApp",
              "inputs": {
                "statusCode": 200,
                "body": {
                  "json": "@{outputs('Loaded_out')}"
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "json": {
                      "title": "json",
                      "x-ms-dynamically-added": true,
                      "type": "string"
                    }
                  }
                }
              },
              "runAfter": {
                "Loaded_out": [
                  "Succeeded"
                ]
              }
            },
            "Loaded_end": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded"
              },
              "runAfter": {
                "Loaded": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Catch": {
          "type": "Scope",
          "actions": {
            "Catch_support": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('Granted site URL (gr_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/lists/getbytitle('AppSettings')/items?$filter=Title eq 'SupportEmail'&$select=Value",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Catch_have_support": {
              "type": "If",
              "expression": "@not(empty(first(body('Catch_support')?['value'])?['Value']))",
              "actions": {
                "Catch_tell_support": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_office365",
                      "operationId": "SendEmailV2",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                    },
                    "parameters": {
                      "emailMessage/To": "@{first(body('Catch_support')?['value'])?['Value']}",
                      "emailMessage/Subject": "Granted flow failed: @{workflow()?['tags']?['flowDisplayName']}",
                      "emailMessage/Body": "<p>The flow <b>@{workflow()?['tags']?['flowDisplayName']}</b> failed (run @{workflow()?['run']?['name']}).</p><pre>@{string(result('Try'))}</pre>",
                      "emailMessage/Importance": "Normal"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Catch_support": [
                  "Succeeded"
                ]
              }
            },
            "Catch_answer": {
              "type": "Response",
              "kind": "PowerApp",
              "inputs": {
                "statusCode": 200,
                "body": {
                  "json": "{\"ok\":false,\"message\":\"Something went wrong. Try again in a moment.\"}"
                },
                "schema": {
                  "type": "object",
                  "properties": {
                    "json": {
                      "title": "json",
                      "x-ms-dynamically-added": true,
                      "type": "string"
                    }
                  }
                }
              },
              "runAfter": {
                "Catch_have_support": [
                  "Succeeded"
                ]
              }
            },
            "Catch_answer_end": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded"
              },
              "runAfter": {
                "Catch_answer": [
                  "Succeeded"
                ]
              }
            },
            "Catch_failed": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed"
              },
              "runAfter": {
                "Catch_answer_end": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Try": [
              "Failed",
              "TimedOut"
            ]
          }
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}