{
  "properties": {
    "connectionReferences": {
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "gr_GrantedOutlook"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "gr_GrantedSharePoint"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "Granted site URL (gr_SiteUrl)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "gr_SiteUrl",
            "description": "The Granted SharePoint site, e.g. https://contoso.sharepoint.com/sites/Granted"
          }
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Hour",
            "interval": 1
          }
        }
      },
      "actions": {
        "Try": {
          "type": "Scope",
          "actions": {
            "Live_projects": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('Granted site URL (gr_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/lists/getbytitle('Projects')/items?$filter=Deleted eq 0&$select=ProjectId,TimeZone,SettingsJson&$top=5000",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Each_project": {
              "type": "Foreach",
              "foreach": "@body('Live_projects')?['value']",
              "actions": {
                "Late_passes": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('Granted site URL (gr_SiteUrl)')",
                      "parameters/method": "GET",
                      "parameters/uri": "_api/web/lists/getbytitle('GatePasses')/items?$filter=ProjectId eq '@{encodeUriComponent(replace(string(items('Each_project')?['ProjectId']), '''', ''''''))}' and Status eq 'Active' and WindowClose lt datetime'@{addMinutes(utcNow(), mul(-1, int(coalesce(json(coalesce(items('Each_project')?['SettingsJson'], '{}'))?['noShowGraceMinutes'], 60))))}'&$select=ID,RequestId&$top=500",
                      "parameters/headers": {
                        "Accept": "application/json;odata=nometadata"
                      }
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                },
                "Each_late_pass": {
                  "type": "Foreach",
                  "foreach": "@body('Late_passes')?['value']",
                  "actions": {
                    "Late_request": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_sharepointonline",
                          "operationId": "HttpRequest",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                        },
                        "parameters": {
                          "dataset": "@parameters('Granted site URL (gr_SiteUrl)')",
                          "parameters/method": "GET",
                          "parameters/uri": "_api/web/lists/getbytitle('DeliveryRequests')/items(@{items('Each_late_pass')?['RequestId']})",
                          "parameters/headers": {
                            "Accept": "application/json;odata=nometadata"
                          }
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runAfter": {}
                    },
                    "Not_told_yet": {
                      "type": "If",
                      "expression": "@and(equals(body('Late_request')?['Status'], 'Approved'), empty(body('Late_request')?['NoShowNotifiedAt']))",
                      "actions": {
                        "Tell_noshow": {
                          "type": "Workflow",
                          "inputs": {
                            "host": {
                              "workflowReferenceName": "ae23cb41-1ff9-5398-a17d-13343d38e345"
                            },
                            "body": {
                              "text": "@{items('Each_project')?['ProjectId']}",
                              "text_1": "noshow",
                              "text_2": "@{items('Each_late_pass')?['RequestId']}",
                              "text_3": "",
                              "text_4": ""
                            }
                          },
                          "runAfter": {}
                        },
                        "Mark_noshow_fields": {
                          "type": "Compose",
                          "inputs": {
                            "NoShowNotifiedAt": "@utcNow()"
                          },
                          "runAfter": {
                            "Tell_noshow": [
                              "Succeeded"
                            ]
                          }
                        },
                        "Mark_noshow": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "connectionName": "shared_sharepointonline",
                              "operationId": "HttpRequest",
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                            },
                            "parameters": {
                              "dataset": "@parameters('Granted site URL (gr_SiteUrl)')",
                              "parameters/method": "POST",
                              "parameters/uri": "_api/web/lists/getbytitle('DeliveryRequests')/items(@{items('Each_late_pass')?['RequestId']})",
                              "parameters/headers": {
                                "Accept": "application/json;odata=nometadata",
                                "Content-Type": "application/json;odata=nometadata",
                                "IF-MATCH": "*",
                                "X-HTTP-Method": "MERGE"
                              },
                              "parameters/body": "@{outputs('Mark_noshow_fields')}"
                            },
                            "authentication": "@parameters('$authentication')"
                          },
                          "runAfter": {
                            "Mark_noshow_fields": [
                              "Succeeded"
                            ]
                          }
                        }
                      },
                      "else": {
                        "actions": {}
                      },
                      "runAfter": {
                        "Late_request": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "runtimeConfiguration": {
                    "concurrency": {
                      "repetitions": 1
                    }
                  },
                  "runAfter": {
                    "Late_passes": [
                      "Succeeded"
                    ]
                  }
                },
                "Slow_reviews": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('Granted site URL (gr_SiteUrl)')",
                      "parameters/method": "GET",
                      "parameters/uri": "_api/web/lists/getbytitle('DeliveryRequests')/items?$filter=ProjectId eq '@{encodeUriComponent(replace(string(items('Each_project')?['ProjectId']), '''', ''''''))}' and Status eq 'Needs review' and ReviewAlertSentAt lt datetime'@{addHours(utcNow(), mul(-1, int(coalesce(json(coalesce(items('Each_project')?['SettingsJson'], '{}'))?['reviewEscalationHours'], 4))))}' and EscalatedAt eq null&$select=ID&$top=200",
                      "parameters/headers": {
                        "Accept": "application/json;odata=nometadata"
                      }
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {
                    "Each_late_pass": [
                      "Succeeded"
                    ]
                  }
                },
                "Each_slow_review": {
                  "type": "Foreach",
                  "foreach": "@body('Slow_reviews')?['value']",
                  "actions": {
                    "Tell_escalation": {
                      "type": "Workflow",
                      "inputs": {
                        "host": {
                          "workflowReferenceName": "ae23cb41-1ff9-5398-a17d-13343d38e345"
                        },
                        "body": {
                          "text": "@{items('Each_project')?['ProjectId']}",
                          "text_1": "escalation",
                          "text_2": "@{items('Each_slow_review')?['ID']}",
                          "text_3": "",
                          "text_4": ""
                        }
                      },
                      "runAfter": {}
                    },
                    "Mark_escalated_fields": {
                      "type": "Compose",
                      "inputs": {
                        "EscalatedAt": "@utcNow()"
                      },
                      "runAfter": {
                        "Tell_escalation": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Mark_escalated": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_sharepointonline",
                          "operationId": "HttpRequest",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                        },
                        "parameters": {
                          "dataset": "@parameters('Granted site URL (gr_SiteUrl)')",
                          "parameters/method": "POST",
                          "parameters/uri": "_api/web/lists/getbytitle('DeliveryRequests')/items(@{items('Each_slow_review')?['ID']})",
                          "parameters/headers": {
                            "Accept": "application/json;odata=nometadata",
                            "Content-Type": "application/json;odata=nometadata",
                            "IF-MATCH": "*",
                            "X-HTTP-Method": "MERGE"
                          },
                          "parameters/body": "@{outputs('Mark_escalated_fields')}"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runAfter": {
                        "Mark_escalated_fields": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "runtimeConfiguration": {
                    "concurrency": {
                      "repetitions": 1
                    }
                  },
                  "runAfter": {
                    "Slow_reviews": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "runAfter": {
                "Live_projects": [
                  "Succeeded"
                ]
              }
            },
            "Old_invites": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('Granted site URL (gr_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/lists/getbytitle('Invites')/items?$filter=Status eq 'Pending' and ExpiresAt lt datetime'@{utcNow()}'&$select=ID&$top=1000",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Each_project": [
                  "Succeeded"
                ]
              }
            },
            "Each_old_invite": {
              "type": "Foreach",
              "foreach": "@body('Old_invites')?['value']",
              "actions": {
                "Expire_fields": {
                  "type": "Compose",
                  "inputs": {
                    "Status": "Expired"
                  },
                  "runAfter": {}
                },
                "Expire": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('Granted site URL (gr_SiteUrl)')",
                      "parameters/method": "POST",
                      "parameters/uri": "_api/web/lists/getbytitle('Invites')/items(@{items('Each_old_invite')?['ID']})",
                      "parameters/headers": {
                        "Accept": "application/json;odata=nometadata",
                        "Content-Type": "application/json;odata=nometadata",
                        "IF-MATCH": "*",
                        "X-HTTP-Method": "MERGE"
                      },
                      "parameters/body": "@{outputs('Expire_fields')}"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {
                    "Expire_fields": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 10
                }
              },
              "runAfter": {
                "Old_invites": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Catch": {
          "type": "Scope",
          "actions": {
            "Catch_support": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('Granted site URL (gr_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/lists/getbytitle('AppSettings')/items?$filter=Title eq 'SupportEmail'&$select=Value",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Catch_have_support": {
              "type": "If",
              "expression": "@not(empty(first(body('Catch_support')?['value'])?['Value']))",
              "actions": {
                "Catch_tell_support": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_office365",
                      "operationId": "SendEmailV2",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                    },
                    "parameters": {
                      "emailMessage/To": "@{first(body('Catch_support')?['value'])?['Value']}",
                      "emailMessage/Subject": "Granted flow failed: @{workflow()?['tags']?['flowDisplayName']}",
                      "emailMessage/Body": "<p>The flow <b>@{workflow()?['tags']?['flowDisplayName']}</b> failed (run @{workflow()?['run']?['name']}).</p><pre>@{string(result('Try'))}</pre>",
                      "emailMessage/Importance": "Normal"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Catch_support": [
                  "Succeeded"
                ]
              }
            },
            "Catch_failed": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed"
              },
              "runAfter": {
                "Catch_have_support": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Try": [
              "Failed",
              "TimedOut"
            ]
          }
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}