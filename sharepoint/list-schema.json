{
  "site": "Granted",
  "timeZone": "Any (UTC recommended): every date-time is stored in UTC and flows convert to each project's own time zone",
  "access": [
    "Only the Granted service account (site owner) and the Granted Owners group (Ajax IT) can open these lists.",
    "People never read or write lists directly. The Granted app talks only to flows, which run as the service account and check the caller's role on the project first.",
    "SecureSettings is locked further: only the service account (and a named break-glass admin) can read it."
  ],
  "groups": {
    "Owners": "Granted Owners (Ajax IT)"
  },
  "lists": [
    {
      "title": "Projects",
      "titleDisplay": "Project name",
      "description": "One item per project. Created and changed only by flows (F15).",
      "fields": [
        {
          "name": "ProjectId",
          "display": "Project ID",
          "type": "Text",
          "indexed": true,
          "unique": true,
          "required": true,
          "note": "e.g. p-7f3k2m (made by F15)"
        },
        {
          "name": "ProjectCode",
          "display": "Project code",
          "type": "Text",
          "indexed": true,
          "unique": true,
          "required": true,
          "note": "e.g. DDC2-7HKQ. Upper case."
        },
        {
          "name": "PassPrefix",
          "display": "Pass prefix",
          "type": "Text",
          "note": "From the code, e.g. DDC2"
        },
        {
          "name": "Location",
          "display": "Location",
          "type": "Text"
        },
        {
          "name": "TimeZone",
          "display": "Time zone",
          "type": "Text",
          "note": "Windows zone name used by convertTimeZone, e.g. 'Central Standard Time'"
        },
        {
          "name": "SettingsJson",
          "display": "Rule settings (JSON)",
          "type": "Note",
          "plain": true,
          "note": "Same keys as config/settings.json"
        },
        {
          "name": "TeamsChannelLink",
          "display": "Teams channel (optional)",
          "type": "Text"
        },
        {
          "name": "GateDutyPhone",
          "display": "Gate duty phone",
          "type": "Text"
        },
        {
          "name": "Deleted",
          "display": "Deleted",
          "type": "Boolean",
          "indexed": true
        },
        {
          "name": "DeletedAt",
          "display": "Deleted at",
          "type": "DateTime"
        },
        {
          "name": "DeletedBy",
          "display": "Deleted by",
          "type": "Text"
        },
        {
          "name": "CreatedByEmail",
          "display": "Created by",
          "type": "Text"
        },
        {
          "name": "CreatedAtUtc",
          "display": "Created at",
          "type": "DateTime"
        }
      ]
    },
