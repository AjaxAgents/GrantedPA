{
  "properties": {
    "connectionReferences": {
      "shared_excelonlinebusiness": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "gr_GrantedExcel"
        },
        "api": {
          "name": "shared_excelonlinebusiness"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "gr_GrantedOutlook"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "gr_GrantedSharePoint"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "Granted Excel library (gr_ExcelDrive)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "gr_ExcelDrive",
            "description": "Drive id of the QRRunner library"
          }
        },
        "Granted engine script (gr_EngineScript)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "gr_EngineScript",
            "description": "Drive item id of GrantedEngine.osts"
          }
        },
        "Granted site URL (gr_SiteUrl)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "gr_SiteUrl",
            "description": "The Granted SharePoint site, e.g. https://contoso.sharepoint.com/sites/Granted"
          }
        },
        "Granted Excel workbook (gr_ExcelWorkbook)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "gr_ExcelWorkbook",
            "description": "Drive item id of QR-Runner.xlsx"
          }
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "PowerAppV2",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "projectId",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "projectId",
                  "x-ms-content-hint": "TEXT"
                },
                "text_1": {
                  "title": "viewAs",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "viewAs",
                  "x-ms-content-hint": "TEXT"
                },
                "text_2": {
                  "title": "payload",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "payload",
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": []
            }
          }
        }
      },
      "actions": {
        "Init_existing": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Existing",
                "type": "object",
                "value": {}
              }
            ]
          },
          "runAfter": {}
        },
        "Init_id": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "SavedId",
                "type": "integer",
                "value": 0
              }
            ]
          },
          "runAfter": {
            "Init_existing": [
              "Succeeded"
            ]
          }
        },
        "Try": {
          "type": "Scope",
          "actions": {
            "In": {
              "type": "Compose",
              "inputs": "@json(if(empty(triggerBody()?['text_2']), '{}', triggerBody()?['text_2']))",
              "runAfter": {}
            },
            "Caller": {
              "type": "Compose",
              "inputs": "@toLower(triggerOutputs()?['headers']?['x-ms-user-email'])",
              "runAfter": {
                "In": [
                  "Succeeded"
                ]
              }
            },
            "ProjectIdIn": {
              "type": "Compose",
              "inputs": "@trim(coalesce(triggerBody()?['text'], ''))",
              "runAfter": {
                "Caller": [
                  "Succeeded"
                ]
              }
            },
            "Authorize": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "282f0f38-3f85-5ebc-be6e-2c2e1eb17c01"
                },
                "body": {
                  "text": "@{outputs('Caller')}",
                  "text_1": "@{outputs('ProjectIdIn')}",
                  "text_2": "@{coalesce(triggerBody()?['text_1'], '')}",
                  "text_3": "delivery.request"
                }
              },
              "runAfter": {
                "ProjectIdIn": [
                  "Succeeded"
                ]
              }
            },
            "Auth": {
              "type": "Compose",
              "inputs": "@json(body('Authorize')?['json'])",
              "runAfter": {
                "Authorize": [
                  "Succeeded"
                ]
              }
            },
            "Is_allowed": {
              "type": "If",
              "expression": "@equals(outputs('Auth')?['ok'], true)",
              "actions": {},
              "else": {
                "actions": {
                  "Not_allowed": {
                    "type": "Response",
                    "kind": "PowerApp",
                    "inputs": {
                      "statusCode": 200,
                      "body": {
                        "json": "@{outputs('Auth')}"
                      },
                      "schema": {
                        "type": "object",
                        "properties": {
                          "json": {
                            "title": "json",
                            "x-ms-dynamically-added": true,
                            "type": "string"
                          }
                        }
                      }
                    },
                    "runAfter": {}
                  },
                  "Not_allowed_end": {
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Succeeded"
                    },
                    "runAfter": {
                      "Not_allowed": [
                        "Succeeded"
                      ]
                    }
                  }
                }
              },
              "runAfter": {
                "Auth": [
                  "Succeeded"
                ]
              }
            },
            "ReqId": {
              "type": "Compose",
              "inputs": "@int(coalesce(outputs('In')?['id'], 0))",
              "runAfter": {
                "Is_allowed": [
                  "Succeeded"
                ]
              }
            },
            "Is_reschedule": {
              "type": "If",
              "expression": "@greater(outputs('ReqId'), 0)",
              "actions": {
                "Get_existing": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('Granted site URL (gr_SiteUrl)')",
                      "parameters/method": "GET",
                      "parameters/uri": "_api/web/lists/getbytitle('DeliveryRequests')/items(@{outputs('ReqId')})",
                      "parameters/headers": {
                        "Accept": "application/json;odata=nometadata"
                      }
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                },
                "Can_change": {
                  "type": "If",
                  "expression": "@and(equals(body('Get_existing')?['ProjectId'], outputs('Auth')?['project']?['id']), or(equals(body('Get_existing')?['SubcontractorId'], outputs('Auth')?['person']?['companyKey']), equals(outputs('Auth')?['role'], 'Admin')), contains(createArray('Approved', 'Needs review', 'Rejected'), body('Get_existing')?['Status']))",
                  "actions": {
                    "Keep_existing": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "Existing",
                        "value": "@body('Get_existing')"
                      },
                      "runAfter": {}
                    }
                  },
                  "else": {
                    "actions": {
                      "Cannot_change": {
                        "type": "Response",
                        "kind": "PowerApp",
                        "inputs": {
                          "statusCode": 200,
                          "body": {
                            "json": "@{string(addProperty(addProperty(json('{}'), 'ok', false), 'message', 'That request can’t be changed now.'))}"
                          },
                          "schema": {
                            "type": "object",
                            "properties": {
                              "json": {
                                "title": "json",
                                "x-ms-dynamically-added": true,
                                "type": "string"
                              }
                            }
                          }
                        },
                        "runAfter": {}
                      },
                      "Cannot_change_end": {
                        "type": "Terminate",
                        "inputs": {
                          "runStatus": "Succeeded"
                        },
                        "runAfter": {
                          "Cannot_change": [
                            "Succeeded"
                          ]
                        }
                      }
                    }
                  },
                  "runAfter": {
                    "Get_existing": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "ReqId": [
                  "Succeeded"
                ]
              }
            },
            "SubId": {
              "type": "Compose",
              "inputs": "@if(greater(outputs('ReqId'), 0), variables('Existing')?['SubcontractorId'], outputs('Auth')?['person']?['companyKey'])",
              "runAfter": {
                "Is_reschedule": [
                  "Succeeded"
                ]
              }
            },
            "SubName": {
              "type": "Compose",
              "inputs": "@if(greater(outputs('ReqId'), 0), variables('Existing')?['SubcontractorName'], outputs('Auth')?['person']?['company'])",
              "runAfter": {
                "SubId": [
                  "Succeeded"
                ]
              }
            },
            "Clean": {
              "type": "Compose",
              "inputs": {
                "activityId": "@substring(trim(string(coalesce(outputs('In')?['activityId'], ''))), 0, min(40, length(trim(string(coalesce(outputs('In')?['activityId'], ''))))))",
                "gateId": "@substring(trim(string(coalesce(outputs('In')?['gateId'], ''))), 0, min(40, length(trim(string(coalesce(outputs('In')?['gateId'], ''))))))",
                "date": "@substring(trim(string(coalesce(outputs('In')?['date'], ''))), 0, min(10, length(trim(string(coalesce(outputs('In')?['date'], ''))))))",
                "slot": "@substring(trim(string(coalesce(outputs('In')?['slot'], ''))), 0, min(5, length(trim(string(coalesce(outputs('In')?['slot'], ''))))))",
                "zoneId": "@substring(trim(string(coalesce(outputs('In')?['zoneId'], ''))), 0, min(40, length(trim(string(coalesce(outputs('In')?['zoneId'], ''))))))",
                "material": "@substring(trim(string(coalesce(outputs('In')?['material'], ''))), 0, min(120, length(trim(string(coalesce(outputs('In')?['material'], ''))))))",
                "unit": "@if(contains(createArray('pcs', 'sections', 'reels', 'units', 'LF', 'crates', 'skids', 'boxes', 'load'), string(coalesce(outputs('In')?['unit'], ''))), string(outputs('In')?['unit']), '')",
                "quantity": "@string(coalesce(outputs('In')?['quantity'], ''))",
                "pallets": "@string(coalesce(outputs('In')?['pallets'], ''))",
                "weightLbs": "@coalesce(outputs('In')?['weightLbs'], 0)",
                "carrier": "@substring(trim(string(coalesce(outputs('In')?['carrier'], ''))), 0, min(80, length(trim(string(coalesce(outputs('In')?['carrier'], ''))))))",
                "truck": "@substring(trim(string(coalesce(outputs('In')?['truck'], ''))), 0, min(40, length(trim(string(coalesce(outputs('In')?['truck'], ''))))))",
                "pocName": "@substring(trim(string(coalesce(outputs('In')?['pocName'], ''))), 0, min(80, length(trim(string(coalesce(outputs('In')?['pocName'], ''))))))",
                "pocPhone": "@substring(trim(string(coalesce(outputs('In')?['pocPhone'], ''))), 0, min(20, length(trim(string(coalesce(outputs('In')?['pocPhone'], ''))))))",
                "justification": "@substring(trim(string(coalesce(outputs('In')?['justification'], ''))), 0, min(500, length(trim(string(coalesce(outputs('In')?['justification'], ''))))))"
              },
              "runAfter": {
                "SubName": [
                  "Succeeded"
                ]
              }
            },
            "Get_gates": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('Granted site URL (gr_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/lists/getbytitle('Gates')/items?$filter=ProjectId eq '@{encodeUriComponent(replace(string(outputs('Auth')?['project']?['id']), '''', ''''''))}' and Active eq 1&$top=200",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Clean": [
                  "Succeeded"
                ]
              }
            },
            "Get_zones": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('Granted site URL (gr_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/lists/getbytitle('StagingZones')/items?$filter=ProjectId eq '@{encodeUriComponent(replace(string(outputs('Auth')?['project']?['id']), '''', ''''''))}' and Active eq 1&$top=200",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Clean": [
                  "Succeeded"
                ]
              }
            },
            "Get_activities": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('Granted site URL (gr_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/lists/getbytitle('Activities')/items?$filter=ProjectId eq '@{encodeUriComponent(replace(string(outputs('Auth')?['project']?['id']), '''', ''''''))}' and IsCurrent eq 1&$top=2000",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Clean": [
                  "Succeeded"
                ]
              }
            },
            "Get_company": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('Granted site URL (gr_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/lists/getbytitle('Companies')/items?$filter=ProjectId eq '@{encodeUriComponent(replace(string(outputs('Auth')?['project']?['id']), '''', ''''''))}' and CompanyKey eq '@{encodeUriComponent(replace(string(outputs('SubId')), '''', ''''''))}'&$top=1",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Clean": [
                  "Succeeded"
                ]
              }
            },
            "Get_company_members": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('Granted site URL (gr_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/lists/getbytitle('ProjectMembers')/items?$filter=ProjectId eq '@{encodeUriComponent(replace(string(outputs('Auth')?['project']?['id']), '''', ''''''))}' and CompanyKey eq '@{encodeUriComponent(replace(string(outputs('SubId')), '''', ''''''))}' and Status eq 'Active'&$select=Trade&$top=500",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Clean": [
                  "Succeeded"
                ]
              }
            },
            "Get_bookings": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('Granted site URL (gr_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/lists/getbytitle('DeliveryRequests')/items?$filter=ProjectId eq '@{encodeUriComponent(replace(string(outputs('Auth')?['project']?['id']), '''', ''''''))}' and DeliveryDayNo ge @{int(replace(addDays(convertFromUtc(utcNow(), outputs('Auth')?['project']?['timeZone'], 'yyyy-MM-dd'), -60, 'yyyy-MM-dd'), '-', ''))}&$select=ID,SubcontractorId,ActivityId,GateId,DeliveryDate,SlotStart,ZoneId,Pallets,StagedUntil,Status,PassCode&$top=5000",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Clean": [
                  "Succeeded"
                ]
              }
            },
            "Trades": {
              "type": "Query",
              "inputs": {
                "from": "@body('Get_company_members')?['value']",
                "where": "@not(empty(item()?['Trade']))"
              },
              "runAfter": {
                "Get_gates": [
                  "Succeeded"
                ],
                "Get_zones": [
                  "Succeeded"
                ],
                "Get_activities": [
                  "Succeeded"
                ],
                "Get_company": [
                  "Succeeded"
                ],
                "Get_company_members": [
                  "Succeeded"
                ],
                "Get_bookings": [
                  "Succeeded"
                ]
              }
            },
            "Ctx_gates": {
              "type": "Select",
              "inputs": {
                "from": "@body('Get_gates')?['value']",
                "select": {
                  "id": "@item()?['GateId']",
                  "name": "@item()?['Title']",
                  "capacityPerSlot": "@coalesce(item()?['CapacityPerSlot'], 1)"
                }
              },
              "runAfter": {
                "Trades": [
                  "Succeeded"
                ]
              }
            },
            "Ctx_zones": {
              "type": "Select",
              "inputs": {
                "from": "@body('Get_zones')?['value']",
                "select": {
                  "id": "@item()?['ZoneId']",
                  "name": "@item()?['Title']",
                  "capacityPallets": "@coalesce(item()?['CapacityPallets'], 0)"
                }
              },
              "runAfter": {
                "Ctx_gates": [
                  "Succeeded"
                ]
              }
            },
            "Ctx_activities": {
              "type": "Select",
              "inputs": {
                "from": "@body('Get_activities')?['value']",
                "select": {
                  "id": "@item()?['ActivityId']",
                  "name": "@item()?['Title']",
                  "trade": "@coalesce(item()?['Trade'], '')",
                  "start": "@item()?['StartDate']",
                  "finish": "@item()?['FinishDate']"
                }
              },
              "runAfter": {
                "Ctx_zones": [
                  "Succeeded"
                ]
              }
            },
            "Ctx_bookings": {
              "type": "Select",
              "inputs": {
                "from": "@body('Get_bookings')?['value']",
                "select": {
                  "id": "@string(item()?['ID'])",
                  "subId": "@coalesce(item()?['SubcontractorId'], '')",
                  "activityId": "@coalesce(item()?['ActivityId'], '')",
                  "gateId": "@coalesce(item()?['GateId'], '')",
                  "date": "@coalesce(item()?['DeliveryDate'], '')",
                  "slot": "@coalesce(item()?['SlotStart'], '')",
                  "zoneId": "@coalesce(item()?['ZoneId'], '')",
                  "pallets": "@coalesce(item()?['Pallets'], 0)",
                  "stagedUntil": "@coalesce(item()?['StagedUntil'], item()?['DeliveryDate'])",
                  "status": "@coalesce(item()?['Status'], '')",
                  "passCode": "@coalesce(item()?['PassCode'], '')",
                  "arrived": false
                }
              },
              "runAfter": {
                "Ctx_activities": [
                  "Succeeded"
                ]
              }
            },
            "Engine_input": {
              "type": "Compose",
              "inputs": {
                "req": {
                  "id": "@if(greater(outputs('ReqId'), 0), string(outputs('ReqId')), 'NEW')",
                  "subId": "@outputs('SubId')",
                  "activityId": "@outputs('Clean')?['activityId']",
                  "gateId": "@outputs('Clean')?['gateId']",
                  "date": "@outputs('Clean')?['date']",
                  "slot": "@outputs('Clean')?['slot']",
                  "zoneId": "@outputs('Clean')?['zoneId']",
                  "material": "@outputs('Clean')?['material']",
                  "quantity": "@outputs('Clean')?['quantity']",
                  "unit": "@outputs('Clean')?['unit']",
                  "pallets": "@outputs('Clean')?['pallets']",
                  "pocName": "@outputs('Clean')?['pocName']",
                  "pocPhone": "@outputs('Clean')?['pocPhone']",
                  "justification": "@outputs('Clean')?['justification']"
                },
                "ctx": {
                  "now": "@convertFromUtc(utcNow(), outputs('Auth')?['project']?['timeZone'], 'yyyy-MM-ddTHH:mm:ss')",
                  "settings": "@outputs('Auth')?['project']?['settings']",
                  "gates": "@body('Ctx_gates')",
                  "zones": "@body('Ctx_zones')",
                  "subs": [
                    {
                      "id": "@outputs('SubId')",
                      "name": "@outputs('SubName')",
                      "trade": "@coalesce(first(body('Trades'))?['Trade'], '')",
                      "suspended": "@equals(first(body('Get_company')?['value'])?['Suspended'], true)"
                    }
                  ],
                  "activities": "@body('Ctx_activities')",
                  "requests": "@body('Ctx_bookings')"
                }
              },
              "runAfter": {
                "Ctx_bookings": [
                  "Succeeded"
                ]
              }
            },
            "Run_rules": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_excelonlinebusiness",
                  "operationId": "RunScriptProdV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_excelonlinebusiness"
                },
                "parameters": {
                  "source": "@parameters('Granted site URL (gr_SiteUrl)')",
                  "drive": "@parameters('Granted Excel library (gr_ExcelDrive)')",
                  "file": "@parameters('Granted Excel workbook (gr_ExcelWorkbook)')",
                  "scriptSource": "@parameters('Granted site URL (gr_SiteUrl)')",
                  "scriptDrive": "@parameters('Granted Excel library (gr_ExcelDrive)')",
                  "scriptId": "@parameters('Granted engine script (gr_EngineScript)')",
                  "ScriptParameters/op": "evaluate",
                  "ScriptParameters/input": "@{outputs('Engine_input')}"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Engine_input": [
                  "Succeeded"
                ]
              }
            },
            "Result": {
              "type": "Compose",
              "inputs": "@json(body('Run_rules')?['result'])",
              "runAfter": {
                "Run_rules": [
                  "Succeeded"
                ]
              }
            },
            "Picked_activity": {
              "type": "Query",
              "inputs": {
                "from": "@body('Ctx_activities')",
                "where": "@equals(item()?['id'], outputs('Clean')?['activityId'])"
              },
              "runAfter": {
                "Result": [
                  "Succeeded"
                ]
              }
            },
            "Fields": {
              "type": "Compose",
              "inputs": {
                "ProjectId": "@{outputs('Auth')?['project']?['id']}",
                "SubcontractorId": "@{outputs('SubId')}",
                "SubcontractorName": "@{outputs('SubName')}",
